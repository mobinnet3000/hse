# ==============================================================================
# HSE GUARD — Environment Variables Configuration Template
# For Controlled Staging and Production Deployments
# ==============================================================================

# ------------------------------------------------------------------------------
# Core Django Application Settings
# ------------------------------------------------------------------------------
# In production/staging, DJANGO_SECRET_KEY MUST be at least 50 characters long and randomized.
DJANGO_SECRET_KEY=replace-me-with-a-long-random-value-minimum-50-characters-in-production
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=staging.hseguard.internal,localhost,127.0.0.1

# ------------------------------------------------------------------------------
# Database Settings
# ------------------------------------------------------------------------------
# DB_ENGINE: 'sqlite3' (local development) or 'postgresql' (staging/production)
DB_ENGINE=postgresql
DB_NAME=hse_guard_staging
DB_USER=hse_guard_user
DB_PASSWORD=strong-db-password-change-me
DB_HOST=127.0.0.1
DB_PORT=5432
DB_CONN_MAX_AGE=60

# Used only if DB_ENGINE=sqlite3
DATABASE_PATH=db.sqlite3

# ------------------------------------------------------------------------------
# Security, SSL & Cookie Hardening
# ------------------------------------------------------------------------------
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SECURE_HSTS_SECONDS=31536000

# ------------------------------------------------------------------------------
# CORS & CSRF Settings
# ------------------------------------------------------------------------------
# Comma-separated list of allowed frontend origins
FRONTEND_ORIGIN=https://staging.hseguard.internal,http://localhost:5173

# ------------------------------------------------------------------------------
# Storage & Media Settings
# ------------------------------------------------------------------------------
# Default media directory relative to BASE_DIR or absolute path
MEDIA_DIR=media

# ------------------------------------------------------------------------------
# External Adapters & Third-Party Integrations (Optional)
# ------------------------------------------------------------------------------
SMS_PANEL_URL=https://api.sms-provider.example/v1/send
SMS_PANEL_API_KEY=
WEATHER_API_URL=https://api.weather.example/v1/forecast
WEATHER_API_KEY=
IOT_MQTT_BROKER_HOST=localhost
IOT_MQTT_BROKER_PORT=1883

# ------------------------------------------------------------------------------
# AI Assistant & Knowledge Base (Optional)
# ------------------------------------------------------------------------------
AI_PROVIDER=
AI_API_KEY=
