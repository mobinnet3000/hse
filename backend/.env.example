# Django Application Settings
DJANGO_SECRET_KEY=replace-me-with-a-long-random-value-minimum-50-characters-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_PATH=db.sqlite3

# Security & SSL Settings (Set in Production)
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SECURE_HSTS_SECONDS=31536000

# CORS & CSRF Settings
FRONTEND_ORIGIN=http://localhost:5173

# Optional AI Assistant (Phase 2+)
AI_PROVIDER=
AI_API_KEY=
